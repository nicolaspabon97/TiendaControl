datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}


model Tienda {
  id            String     @id @default(uuid())
  nombreTienda  String
  nit           String?
  ciudad        String     @default("Popayán")
  direccion     String?
  telefono      String?
  activa        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  usuarios      Usuario[]
  productos     Producto[]
  ventas        Venta[]
}

model Usuario {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  rol String @default("ADMIN_TIENDA")
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tiendaId     String?
  tienda       Tienda?  @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  ventasCobradas Venta[]
}

model Producto {
  id        String   @id @default(uuid())
  codigo    String
  nombre    String
  stock     Int      @default(0)
  precio    Float    @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tiendaId  String
  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  itemsVentas DetalleVenta[]

  @@unique([codigo, tiendaId]) // El código es único DENTRO de cada tienda
}

model Venta {
  id             String         @id @default(uuid())
  numeroFactura  String
  total          Float
  createdAt      DateTime       @default(now())

  tiendaId       String
  tienda         Tienda         @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  cajeroId       String
  cajero         Usuario        @relation(fields: [cajeroId], references: [id])

  detalles       DetalleVenta[]
}

model DetalleVenta {
  id         String   @id @default(uuid())
  cantidad   Int
  precioUnit Float
  subtotal   Float

  ventaId    String
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
}